<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menú Principal -->
    <menuitem id="menu_user_visibility_root"
              name="Visibilidad de Usuario"
              sequence="100"
              groups="base.group_system"
              web_icon="menu_control_visibilidad,static/description/icon.png"/>

    <!-- Submenú: Configuración de Usuarios -->
    <menuitem id="menu_user_visibility_config"
              name="Configuración de Usuarios"
              parent="menu_user_visibility_root"
              action="action_user_visibility_config"
              sequence="10"/>

    <!-- Acceso desde Configuración > Usuarios -->
    <menuitem id="menu_user_visibility_settings"
              name="Control de Menús por Usuario"
              parent="base.menu_users"
              action="action_user_visibility_config"
              sequence="50"
              groups="base.group_system"/>

</odoo>
