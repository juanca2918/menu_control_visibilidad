<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Kanban de Visibilidad de Menús -->
    <record id="view_menu_visibility_kanban" model="ir.ui.view">
        <field name="name">user.menu.visibility.kanban</field>
        <field name="model">user.menu.visibility</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="parent_menu_id">
                <field name="user_id"/>
                <field name="menu_id"/>
                <field name="parent_menu_id"/>
                <field name="model_name"/>
                <field name="visible"/>
                <field name="can_create"/>
                <field name="can_write"/>
                <field name="can_unlink"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="menu_id"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle" t-if="record.parent_menu_id.raw_value">
                                        <i class="fa fa-level-up"/> <field name="parent_menu_id"/>
                                    </div>
                                    <div class="o_kanban_record_subtitle text-muted" t-if="record.model_name.raw_value">
                                        <i class="fa fa-database"/> <field name="model_name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span t-if="record.visible.raw_value" class="badge badge-success">
                                            <i class="fa fa-eye"/> Visible
                                        </span>
                                        <span t-else="" class="badge badge-danger">
                                            <i class="fa fa-eye-slash"/> Oculto
                                        </span>
                                    </div>
                                    <div class="col-6 text-right">
                                        <span t-if="!record.active.raw_value" class="badge badge-secondary">
                                            <i class="fa fa-pause"/> Inactivo
                                        </span>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <span t-if="record.can_create.raw_value" class="badge badge-info mr-1">
                                            <i class="fa fa-plus-circle"/> Crear
                                        </span>
                                        <span t-if="record.can_write.raw_value" class="badge badge-info mr-1">
                                            <i class="fa fa-edit"/> Editar
                                        </span>
                                        <span t-if="record.can_unlink.raw_value" class="badge badge-info">
                                            <i class="fa fa-trash"/> Eliminar
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Tree de Visibilidad de Menús - Estilo Jerárquico -->
    <record id="view_menu_visibility_tree" model="ir.ui.view">
        <field name="name">user.menu.visibility.tree</field>
        <field name="model">user.menu.visibility</field>
        <field name="arch" type="xml">
            <list string="Configuración de Permisos" editable="bottom" 
                  default_order="menu_path">
                <field name="menu_path" column_invisible="1"/>
                <field name="menu_complete_name" string="Menú / Opción" readonly="1"/>
                <field name="visible" string="✅ Ver" widget="boolean_toggle"/>
                <field name="active" invisible="1"/>
                <field name="user_id" column_invisible="1"/>
                <field name="menu_id" column_invisible="1"/>
                <field name="parent_menu_id" column_invisible="1"/>
                <field name="model_name" invisible="1"/>
                <field name="can_create" invisible="1"/>
                <field name="can_write" invisible="1"/>
                <field name="can_unlink" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Visibilidad de Menús -->
    <record id="view_menu_visibility_form" model="ir.ui.view">
        <field name="name">user.menu.visibility.form</field>
        <field name="model">user.menu.visibility</field>
        <field name="arch" type="xml">
            <form string="Configuración de Menú">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="menu_id" options="{'no_create': True}"/>
                            <field name="parent_menu_id"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="visible"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Permisos de Operación">
                        <group>
                            <field name="can_create"/>
                            <field name="can_write"/>
                        </group>
                        <group>
                            <field name="can_unlink"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search de Visibilidad de Menús -->
    <record id="view_menu_visibility_search" model="ir.ui.view">
        <field name="name">user.menu.visibility.search</field>
        <field name="model">user.menu.visibility</field>
        <field name="arch" type="xml">
            <search string="Buscar Configuración de Menús">
                <field name="user_id"/>
                <field name="menu_id"/>
                <field name="parent_menu_id"/>
                <field name="model_name"/>
                <separator/>
                <filter string="✅ Visibles" name="visible" domain="[('visible', '=', True)]"/>
                <filter string="❌ Ocultos" name="hidden" domain="[('visible', '=', False)]"/>
                <separator/>
                <filter string="🔵 Menús Principales" name="main_menus" domain="[('parent_menu_id', '=', False)]"/>
                <filter string="📂 Submenús" name="submenus" domain="[('parent_menu_id', '!=', False)]"/>
                <separator/>
                <filter string="➕ Con Permiso Crear" name="can_create" domain="[('can_create', '=', True)]"/>
                <filter string="🚫 Sin Permiso Crear" name="no_create" domain="[('can_create', '=', False)]"/>
                <filter string="✏️ Con Permiso Editar" name="can_write" domain="[('can_write', '=', True)]"/>
                <filter string="🚫 Sin Permiso Editar" name="no_write" domain="[('can_write', '=', False)]"/>
                <filter string="🗑️ Con Permiso Eliminar" name="can_unlink" domain="[('can_unlink', '=', True)]"/>
                <filter string="🚫 Sin Permiso Eliminar" name="no_delete" domain="[('can_unlink', '=', False)]"/>
                <separator/>
                <filter string="⚡ Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="⏸️ Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="📁 Menú Padre" name="group_by_parent" context="{'group_by': 'parent_menu_id'}"/>
                    <filter string="👤 Usuario" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="📦 Modelo" name="group_by_model" context="{'group_by': 'model_name'}"/>
                    <filter string="✅/❌ Visible" name="group_by_visible" context="{'group_by': 'visible'}"/>
                    <filter string="⚡ Estado" name="group_by_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_menu_visibility" model="ir.actions.act_window">
        <field name="name">Configuración de Permisos por Menú</field>
        <field name="res_model">user.menu.visibility</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{
            'search_default_active': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure permisos de menú por usuario
            </p>
            <p>
                Use los checkboxes para controlar:
            </p>
            <ul>
                <li><strong>✅ Visible</strong>: Si el usuario puede ver el menú/opción</li>
                <li><strong>➕ Crear</strong>: Si puede crear registros</li>
                <li><strong>✏️ Editar</strong>: Si puede modificar registros</li>
                <li><strong>🗑️ Eliminar</strong>: Si puede borrar registros</li>
            </ul>
            <p>
                Los menús están ordenados jerárquicamente por menú principal y sus opciones.
            </p>
        </field>
    </record>

</odoo>
